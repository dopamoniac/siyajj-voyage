{
  "rootDirectory": "artifacts/siyajj",
  "installCommand": "cd ../../ && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../../ && pnpm --filter @workspace/siyajj run build",
  "outputDirectory": "dist/public",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
